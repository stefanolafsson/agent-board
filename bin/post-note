#!/usr/bin/env python3
"""Post a note to the board inbox.

    post-note --to reviewer --type candidate --subject "Title" --body "Markdown body"
    echo "body" | post-note --to curator --type review --subject "Title"

Inside an agent run, `from`, `chain` and `hop` are filled in from the
environment the watcher sets (BOARD_ROLE, BOARD_CHAIN, BOARD_HOP), so the
loop guard can count hand-offs. Outside a run, the note starts a new chain
from the human named in board.toml.
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "engine"))
from boardlib import HUMAN, Note, new_chain_id, post_note  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--to", required=True, help="role to address, or the human's name from board.toml")
    parser.add_argument("--type", required=True, help="e.g. candidate, review, request, morning-search")
    parser.add_argument("--subject", default="", help="one-line subject")
    parser.add_argument("--body", help="markdown body (otherwise read from stdin)")
    args = parser.parse_args()

    body = args.body if args.body is not None else ("" if sys.stdin.isatty() else sys.stdin.read())
    in_run = "BOARD_CHAIN" in os.environ
    note = Note(
        to=args.to.strip().lower(),
        sender=os.environ.get("BOARD_ROLE", HUMAN),
        type=args.type.strip(),
        subject=args.subject.strip(),
        body=body,
        chain=os.environ["BOARD_CHAIN"] if in_run else new_chain_id(),
        hop=int(os.environ.get("BOARD_HOP", "0")) + 1 if in_run else 0,
    )
    path = post_note(note)
    print(f"posted {path.name} (to={note.to}, chain={note.chain}, hop={note.hop})")


if __name__ == "__main__":
    main()
