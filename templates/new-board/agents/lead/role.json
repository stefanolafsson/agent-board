{
  "description": "Front desk: you talk to it; it addresses notes to the right agents, reports status, handles escalations, and proposes agent changes for your approval.",
  "model": "sonnet",
  "resident": true,
  "tools": ["Read", "Glob", "Grep", "Bash", "Write", "Edit"],
  "allow": [
    "Read", "Glob", "Grep",
    "Bash(post-note *)", "Bash(board status*)",
    "Write({board}/proposals/**)", "Edit({board}/proposals/**)",
    "Write({root}/agents/**)", "Edit({root}/agents/**)", "Edit({root}/board.toml)"
  ],
  "add_dirs": ["{root}"],
  "max_budget_usd": 1.0,
  "timeout_s": 900
}
