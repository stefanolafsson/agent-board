{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 \"{engine}/engine/session_start.py\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash({engine}/bin/post-note *)",
      "Bash({engine}/bin/board status*)",
      "Bash({engine}/bin/board up*)"
    ]
  }
}
